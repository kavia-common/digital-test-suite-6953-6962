# Frontend port (Create React App will use this for dev server)
REACT_APP_PORT=3000

# Backend API base endpoint (should include /api suffix if backend exposes APIs under /api)
# For local dev with the provided backend, this is the default:
REACT_APP_API_BASE=http://localhost:3001/api

# Alternative: use a backend base URL (without /api) and the code will append /api automatically.
# REACT_APP_BACKEND_URL=http://localhost:3001

# Optional healthcheck path override (defaults to /api/health)
# REACT_APP_HEALTHCHECK_PATH=/api/health

# Feature flags (JSON string). Example: {"newScoring":"on"}
# REACT_APP_FEATURE_FLAGS={"newScoring":"on"}

# Experiments toggle (true/false)
# REACT_APP_EXPERIMENTS_ENABLED=false
